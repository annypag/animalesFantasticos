{
  "name": "animales-fantasticos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d postgres pgadmin",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres pgadmin",
    "db:seed": "prisma db seed",
    "db:backfill": "npx tsx prisma/backfill-embeddings.ts",
    "postinstall": "prisma generate",
    "db:enable-vector": "node prisma/enable-vector.js",
    "db:setup-neon": "npm run db:enable-vector && npx prisma db push && npx prisma generate"
  },
  "prisma": {
    "seed": "node --env-file=.env.local prisma/seed.js"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@imgly/background-removal-node": "^1.4.5",
    "@prisma/client": "^6.16.2",
    "@vercel/blob": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
