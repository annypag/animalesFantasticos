generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id        BigInt    @id @default(autoincrement()) @db.BigInt
  fullName  String    @map("full_name")
  phone     String
  email     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  foundPets FoundPet[]
  lostPets  LostPet[]

  @@map("owners")
}

model FoundPet {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  ownerId     BigInt   @map("owner_id") @db.BigInt
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  species     String
  breed       String
  imageUrl    String   @map("image_url")
  description String
  locationText String  @map("location_text")
  latitude    Float
  longitude   Float
  foundAt     DateTime @default(now()) @map("found_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "found_pets_created_at_idx")
  @@map("found_pets")
}

model LostPet {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  ownerId      BigInt   @map("owner_id") @db.BigInt
  owner        Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  species      String
  breed        String
  imageUrl     String   @map("image_url")
  description  String
  locationText String   @map("location_text")
  latitude     Float
  longitude    Float
  lastSeen     String   @map("last_seen") // Usamos String porque en el modal lo capturamos como texto libre ("Hoy a las 15:00 hrs")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "lost_pets_created_at_idx")
  @@map("lost_pets")
}

enum PetReportKind {
  FOUND
  LOST
}

model Conversation {
  id        BigInt        @id @default(autoincrement()) @db.BigInt
  petKind   PetReportKind @map("pet_kind")
  petId     BigInt        @map("pet_id") @db.BigInt
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  messages  Message[]

  @@unique([petKind, petId], map: "conversations_pet_uid")
  @@map("conversations")
}

model Message {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  conversationId BigInt       @map("conversation_id") @db.BigInt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderName     String       @default("Usuario") @map("sender_name")
  body           String?
  imageUrl       String?      @map("image_url")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt(sort: Asc)], map: "messages_conversation_created_idx")
  @@map("messages")
}