# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# prisma generated client
src/generated/prisma/

# uploaded images (keep folders via .gitkeep)
/public/uploads/chat/*
!/public/uploads/chat/.gitkeep
/public/uploads/reports/*
!/public/uploads/reports/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
